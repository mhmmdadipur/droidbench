{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Droidbench",
  "version": "0.2.0",
  "identifier": "com.mhmmdadipur.droidbench",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Droidbench",
        "width": 1320,
        "height": 800,
        "minWidth": 1040,
        "minHeight": 620,
        "decorations": false,
        "shadow": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "databases/*",
      "binaries/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mhmmdadipur/droidbench/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExMzZBN0RDNTgzQzM5NDMKUldSRE9UeFkzS2MyRVZFMnVLZVFqVElTRDdJdnVsMExRaGVpSDVxWHFUcHpvclpVS1lQbnVPbzMK"
    }
  }
}
